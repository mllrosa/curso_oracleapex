-- CRIANDO A TABELA PEDIDO
CREATE TABLE PEDIDO (
    ped_numero INT NOT NULL,
    ped_data DATE,
    ped_valorTotal DECIMAL(6,2),
    ped_numeroPessoas INT,
    cli_codigo INT,
    fpg_codigo INT
);

-- CRIANDO A TABELA ITEMPEDIDO
CREATE TABLE ITEMPEDIDO (
    itm_numero INT NOT NULL,
    itm_quantidade INT,
    itm_valorUnitario DECIMAL,
    itm_valorTotal DECIMAL,
    ped_numero INT,
    gar_codigo INT,
    car_codigo INT
);


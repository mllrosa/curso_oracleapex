-- Drops para excuir tabelas existentes(deve ser executado apenas um por vez)
DROP TABLE ITEMPEDIDO CASCADE CONSTRAINTS;
DROP TABLE PEDIDO CASCADE CONSTRAINTS;
DROP TABLE CARDAPIO CASCADE CONSTRAINTS;
DROP TABLE CATEGORIA CASCADE CONSTRAINTS;
DROP TABLE FORMAPAGAMENTO CASCADE CONSTRAINTS;
DROP TABLE GARCOM CASCADE CONSTRAINTS;
DROP TABLE CLIENTE CASCADE CONSTRAINTS;

-- Recriando as tabelas anteriores
CREATE TABLE CATEGORIA (
    cat_codigo INT,
    cat_nome VARCHAR2(50) NOT NULL,
    CONSTRAINT pk_categoria PRIMARY KEY (cat_codigo)
);

CREATE TABLE FORMAPAGAMENTO (
    fpg_codigo INT,
    fpg_nome VARCHAR2(50) NOT NULL,
    CONSTRAINT pk_formapagamento PRIMARY KEY (fpg_codigo)
);

CREATE TABLE GARCOM (
    gar_codigo INT,
    gar_nome VARCHAR2(60) NOT NULL,
    gar_datanascimento VARCHAR2(10),
    gar_horaTrabalho VARCHAR2(15),
    CONSTRAINT pk_garcom PRIMARY KEY (gar_codigo)
);

CREATE TABLE CLIENTE (
    cli_codigo INT,
    cli_cpf VARCHAR2(14) NOT NULL,
    cli_nome VARCHAR2(60) NOT NULL,
    cli_dataNascimento VARCHAR2(10),
    cli_email VARCHAR2(60),
    cli_telefone VARCHAR2(15),
    cli_status VARCHAR2(1),
    CONSTRAINT pk_cliente PRIMARY KEY (cli_codigo)
);

CREATE TABLE CARDAPIO (
    car_codigo INT,
    car_nome VARCHAR2(50) NOT NULL,
    car_preco DECIMAL(8,2) NOT NULL,
    car_unidade INT,
    car_pesolitro INT,
    cat_codigo INT,
    CONSTRAINT pk_cardapio PRIMARY KEY (car_codigo),
    CONSTRAINT fk_cardapio_categoria FOREIGN KEY (cat_codigo) REFERENCES CATEGORIA(cat_codigo)
);

CREATE TABLE PEDIDO (
    ped_numero INT,
    ped_data DATE NOT NULL,
    ped_valorTotal DECIMAL(8,2),
    ped_numeroPessoas INT,
    cli_codigo INT,
    fpg_codigo INT,
    CONSTRAINT pk_pedido PRIMARY KEY (ped_numero),
    CONSTRAINT fk_pedido_cliente FOREIGN KEY (cli_codigo) REFERENCES CLIENTE(cli_codigo),
    CONSTRAINT fk_pedido_formapg FOREIGN KEY (fpg_codigo) REFERENCES FORMAPAGAMENTO(fpg_codigo)
);

CREATE TABLE ITEMPEDIDO (
    itm_numero INT,
    itm_quantidade INT NOT NULL,
    itm_valorunitario DECIMAL(8,2) NOT NULL,
    itm_valorTotal DECIMAL(8,2),
    ped_numero INT,
    gar_codigo INT,
    car_codigo INT,
    CONSTRAINT pk_itempedido PRIMARY KEY (itm_numero),
    CONSTRAINT fk_item_pedido FOREIGN KEY (ped_numero) REFERENCES PEDIDO(ped_numero),
    CONSTRAINT fk_item_garcom FOREIGN KEY (gar_codigo) REFERENCES GARCOM(gar_codigo),
    CONSTRAINT fk_item_cardapio FOREIGN KEY (car_codigo) REFERENCES CARDAPIO(car_codigo)
);


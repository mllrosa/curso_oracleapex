-- 1. Exibir o nome e e-mail de todos os contatos, em ordem alfabética ascendente. (nome, celular, email, idade, cidade, estado, cpf)
select nome, email from contatos order by nome asc;

-- 2. Exibir o nome e e-mail de todos os contatos do Estado de SP.
select nome, email, estado from contatos where estado = 'SP';

-- 3. Exibir o nome e e-mail de todos os contatos do sexo feminino.
select nome, email, sexo from contatos where sexo = 'F';

-- 4. Exibir o nome, e-mail e cidade de todos os contatos do estado de SP e sexo feminino, em ordem de cidade.
select nome, email, cidade from contatos where estado = 'SP' and sexo = 'F' order by cidade asc;

-- 5. Exibir o nome e celular de todos os contatos, cujo nome começa com a letra A
select nome, email, cidade from contatos where nome like 'A%';

-- 6. Exibir o nome e cidade dos contatos com idade acima de 18, da cidade de Santana de Parnaíba.
select nome, cidade from contatos where idade > 18 and cidade = 'São Paulo';

-- 7. Quantos contatos?
select count(*) from contatos;

-- 8. Quantos contatos no estado de SP?
select count(*) from contatos where estado = 'SP';

-- 9. Quantos contatos do sexo feminino?
select count(*) from contatos where sexo = 'F';

-- 10. Quantos contatos por estado?
SELECT COUNT(*)
FROM contatos
GROUP BY estado;

SELECT estado, COUNT(*)
FROM contatos
GROUP BY estado;

select * from contatos;

SELECT SUM(idade)
FROM contatos;

SELECT AVG(idade)
FROM contatos;

SELECT MAX(idade)
FROM contatos;

SELECT MIN(idade)
FROM contatos;


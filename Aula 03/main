-- ============================================================================================
-- Alterando a tabela adicionando a coluna cpf
alter table contatos add cpf Varchar(14);

--  Deletando as linhas da tabela coluna em que a coluna nome correspode ROSA
delete from contatos where nome = 'ROSA';	WKSP_ORACLEROSA

-- Alterando a tabela par aexcluir a coluna sexo
alter table contatos drop column sexo;

--  Alterando o email de uma linha com update
update contatos set email = '@email.com' where email = 'seuemail@xxxx.com.br';	WKSP_ORACLEROSA


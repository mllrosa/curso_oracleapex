-- Escreva a instrução SQL para:

-- 1. Exibir o nome e email de todos os clientes. Ordenar o resultado por nome.
select cli_nome, cli_email from cliente order by cli_nome asc

-- 2. Exibir o nome e email dos clientes que possuem email do gmail.
select cli_nome, cli_email from cliente where cli_email is null

-- 3. Exibir o nome dos clientes que não possuem email.
select cli_nome, cli_email from cliente where cli_email is not null

-- 4. Exibir o Status e o nome do cliente.
select cli_status, cli_nome from cliente

-- 5. Quantos clientes estão ativos?
select count(*) from cliente where cli_status = 'A'

-- 6. Quantos clientes estão inativos?
select count(*) from cliente where cli_status = 'I'

-- 7. Exibir a quantidade de clientes por Status.
select cli_status, count(*) from cliente group by cli_status

-- 8. Exibir o código, nome e preço de todos os itens do cardápio.
select car_codigo, car_nome, car_preco from cardapio

-- 9. Exibir o nome da categoria, código, nome e preço de todos os itens do cardápio.
SELECT 
    categoria.CAT_NOME,
    cardapio.CAR_CODIGO,
    cardapio.CAR_NOME,
    cardapio.CAR_PRECO
FROM cardapio, categoria
WHERE cardapio.CAT_CODIGO = categoria.CAT_CODIGO;

